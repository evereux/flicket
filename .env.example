# ---------------------------------------------------------------------------
# Copy to .env with `make docker-init` - it replaces every placeholder token
# with its own random secret and never overwrites an existing .env.
# .env is gitignored; never commit real credentials.
# ---------------------------------------------------------------------------

# Host port for the web app, and the host port exposing MariaDB in dev only.
PORT=5000
DB_PORT_HOST=3307

# MariaDB credentials. DB_NAME / DB_USER / DB_PASSWORD are also used by the
# app to build the SQLAlchemy URI, so they must match the MARIADB_* values.
# Keep passwords URL-safe (the app interpolates them straight into the URI).
DB_NAME=flicket
DB_USER=flicket
DB_PASSWORD=__GENERATED__
MARIADB_ROOT_PASSWORD=__GENERATED__

# Flask session signing key. Must stay stable across container restarts or
# all users are logged out. The internal notification user's password.
SECRET_KEY=__GENERATED__
NOTIFICATION_USER_PASSWORD=__GENERATED__

# Optional Zitadel SSO (disabled by default).
ZITADEL_ENABLED=false
ZITADEL_ISSUER=https://id.exam-studio.com
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# Optional Celery settings (periodic tasks). Defaults point at the compose
# `redis` service; adjust if you run a Redis of your own.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=UTC
